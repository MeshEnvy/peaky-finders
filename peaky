#!/usr/bin/env bash
# Dev-only: run Peaky Web GUI in peaky:dev with port 8765 published.
set -euo pipefail

SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [[ "$SCRIPT" != /* ]] && SCRIPT="$DIR/$SCRIPT"
done
ROOT="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
IMAGE="${PEAKY_DEV_IMAGE:-peaky:dev}"
FORCE_BUILD=0

for arg in "$@"; do
  if [ "$arg" = "--build" ]; then
    FORCE_BUILD=1
  fi
done

if [ "$FORCE_BUILD" = 1 ] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "peaky: building ${IMAGE}..." >&2
  PLATFORM="${PEAKY_DOCKER_PLATFORM:-}"
  if [ -n "$PLATFORM" ]; then
    docker build --platform "$PLATFORM" --target dev -t "$IMAGE" "$ROOT"
  else
    docker build --target dev -t "$IMAGE" "$ROOT"
  fi
fi

CACHE_DIR="${PEAKY_CACHE_DIR:-$HOME/.peaky/splat_cache}"
mkdir -p "$CACHE_DIR"

PROJECTS_MOUNT="${PEAKY_PROJECTS_DIR:-$PWD/projects}"
mkdir -p "$PROJECTS_MOUNT"

DOCKER_FLAGS=(--rm)
if [ -t 0 ] && [ -t 1 ]; then
  DOCKER_FLAGS+=(-it)
fi

case "${DEBUG:-}" in 1|true|yes|on|TRUE|YES|ON)
  echo "peaky: DEBUG=1 (verbose operation logging)" >&2
  ;;
esac

exec docker run "${DOCKER_FLAGS[@]}" \
  --add-host=host.docker.internal:host-gateway \
  -e DEBUG="${DEBUG:-}" \
  -e POETRY_VIRTUALENVS_CREATE=false \
  -e PEAKY_PROJECTS=/projects \
  -p 8765:8765 \
  -v "$ROOT/peaky_finders:/app/peaky_finders" \
  -v "$PROJECTS_MOUNT:/projects" \
  -v "$CACHE_DIR:/.peaky/splat_cache" \
  -w /app/peaky_finders \
  --entrypoint bash \
  "$IMAGE" \
  -lc 'cd /app/peaky_finders && poetry install --no-interaction && exec poetry run peaky --host 0.0.0.0 --port 8765'
