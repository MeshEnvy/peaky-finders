#!/usr/bin/env bash
# Dev-only: build/run peaky:dev (serve, test) with live peaky_finders mount.
set -euo pipefail

_script="$0"
while [ -L "$_script" ]; do
  _dir="$(cd -P "$(dirname "$_script")" && pwd)"
  _script="$(readlink "$_script")"
  [[ "$_script" != /* ]] && _script="$_dir/$_script"
done
ROOT="$(cd -P "$(dirname "$_script")" && pwd)"

IMAGE="${PEAKY_DEV_IMAGE:-peaky:dev}"
CACHE_DIR="${PEAKY_CACHE_DIR:-$HOME/.peaky/splat_cache}"
# Host-persisted build caches (cargo registry, splatter target, stamp files).
DEV_CACHE="${PEAKY_DEV_CACHE:-${CACHE_DIR%/splat_cache}/dev-cache}"
OPS_PEAKY_HOME="$ROOT/../../ops/peaky_home"
if [ -n "${PEAKY_HOME:-}" ]; then
  PEAKY_HOME_DIR="$PEAKY_HOME"
elif [ -d "$OPS_PEAKY_HOME" ]; then
  PEAKY_HOME_DIR="$OPS_PEAKY_HOME"
else
  PEAKY_HOME_DIR="$ROOT/peaky_home"
fi
mkdir -p "$PEAKY_HOME_DIR" "$CACHE_DIR"
mkdir -p "$DEV_CACHE/cargo-registry" "$DEV_CACHE/cargo-git" "$DEV_CACHE/splatter-target" "$DEV_CACHE/build-stamps"

filtered=()
force_splatter_rebuild=0
for arg in "$@"; do
  case "$arg" in
    --build) ;;
    --rebuild-splatter) force_splatter_rebuild=1 ;;
    *) filtered+=("$arg") ;;
  esac
done

wants_build=0
for arg in "$@"; do
  if [ "$arg" = "--build" ]; then
    wants_build=1
    break
  fi
done
if [ "$wants_build" = 1 ] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "peaky: building ${IMAGE} (layered: cargo fetch → splatter wheel → poetry deps)…" >&2
  platform="${PEAKY_DOCKER_PLATFORM:-}"
  build_args=(--progress=plain --target dev -t "$IMAGE" "$ROOT")
  export DOCKER_BUILDKIT=1
  if [ -n "$platform" ]; then
    docker build --platform "$platform" "${build_args[@]}"
  else
    docker build "${build_args[@]}"
  fi
fi

SPLATTER_MOUNT=(-v "$ROOT/splatter:/app/splatter")
DEV_CACHE_FLAGS=(
  -v "$DEV_CACHE/cargo-registry:/usr/local/cargo/registry"
  -v "$DEV_CACHE/cargo-git:/usr/local/cargo/git"
  -v "$DEV_CACHE/splatter-target:/app/splatter/target"
  -v "$DEV_CACHE:/.peaky-dev-cache"
  -e "PEAKY_CACHE=/.peaky-dev-cache"
  -e "PEAKY_FORCE_SPLATTER_REBUILD=${force_splatter_rebuild}"
)

DOCKER_FLAGS=(--rm)
if [ -t 0 ] && [ -t 1 ]; then
  DOCKER_FLAGS+=(-it)
fi

PEAKY_HOME_FLAGS=(-v "$PEAKY_HOME_DIR:/.peaky" -e "PEAKY_HOME=/.peaky" -v "$CACHE_DIR:/.peaky/splat_cache")

mode=cli
if [ ${#filtered[@]} -gt 0 ] && [ "${filtered[0]}" = "test" ]; then
  mode=test
  filtered=("${filtered[@]:1}")
elif [ ${#filtered[@]} -gt 0 ] && [ "${filtered[0]}" = "run" ]; then
  mode=run
  filtered=("${filtered[@]:1}")
elif [ ${#filtered[@]} -gt 0 ] && [ "${filtered[0]}" = "serve" ]; then
  SERVE_PORT="${PEAKY_SERVE_PORT:-8080}"
  serve_no_reload=0
  serve_has_reload=0
  i=1
  while [ $i -lt ${#filtered[@]} ]; do
    arg="${filtered[$i]}"
    case "$arg" in
      --no-reload) serve_no_reload=1 ;;
      --reload) serve_has_reload=1 ;;
      --port)
        if [ $((i + 1)) -lt ${#filtered[@]} ]; then
          SERVE_PORT="${filtered[$((i + 1))]}"
        fi
        ;;
      --port=*) SERVE_PORT="${arg#--port=}" ;;
    esac
    i=$((i + 1))
  done
  if [ "$serve_no_reload" -eq 0 ] && [ "$serve_has_reload" -eq 0 ]; then
    filtered=(serve --reload "${filtered[@]:1}")
  fi
  DOCKER_FLAGS+=(-p "${SERVE_PORT}:${SERVE_PORT}")
  DOCKER_FLAGS+=("${PEAKY_HOME_FLAGS[@]}" -v "$ROOT/peaky_finders:/app/peaky_finders")
  DOCKER_FLAGS+=("${SPLATTER_MOUNT[@]}")
  DOCKER_FLAGS+=("${DEV_CACHE_FLAGS[@]}")
fi

if [ "$mode" = test ]; then
  TEST_HOME="$ROOT/peaky_finders/tests/fixtures/peaky_home"
  run_cmd=(docker run "${DOCKER_FLAGS[@]}" \
    -e POETRY_VIRTUALENVS_CREATE=false \
    -e "PEAKY_SKIP_SPLATTER=${PEAKY_SKIP_SPLATTER:-0}" \
    -e PEAKY_BOOTSTRAP_MODE=test \
    "${DEV_CACHE_FLAGS[@]}" \
    -v "$ROOT/peaky_finders:/app/peaky_finders" \
    "${SPLATTER_MOUNT[@]}" \
    -v "$TEST_HOME:/.peaky" \
    -e "PEAKY_HOME=/.peaky" \
    -v "$CACHE_DIR:/.peaky/splat_cache" \
    -w /app/peaky_finders \
    --entrypoint bash \
    "$IMAGE" \
    -lc "set -e
peaky-dev-bootstrap
exec poetry run pytest -ra --durations=20 \"\$@\"" \
    _)
elif [ "$mode" = run ]; then
  run_cmd=(docker run "${DOCKER_FLAGS[@]}" \
    -e POETRY_VIRTUALENVS_CREATE=false \
    -e PEAKY_SKIP_SPLATTER=1 \
    -e PEAKY_BOOTSTRAP_MODE=run \
    -v "$PWD:/project" \
    -v "$ROOT/peaky_finders:/app/peaky_finders" \
    "${PEAKY_HOME_FLAGS[@]}" \
    -w /project \
    --entrypoint bash \
    "$IMAGE" \
    -lc "set -e
peaky-dev-bootstrap
cd /project && PATH=/app/peaky_finders/.venv/bin:\${PATH} exec \"\$@\""
    _)
else
  run_cmd=(docker run "${DOCKER_FLAGS[@]}" \
    -e POETRY_VIRTUALENVS_CREATE=false \
    -e POETRY_VIRTUALENVS_IN_PROJECT=false \
    -e PEAKY_BOOTSTRAP_MODE=serve \
    "${DEV_CACHE_FLAGS[@]}" \
    -v "$PWD:/project" \
    -v "$ROOT/peaky_finders:/app/peaky_finders" \
    "${SPLATTER_MOUNT[@]}" \
    "${PEAKY_HOME_FLAGS[@]}" \
    -w /project \
    --entrypoint bash \
    "$IMAGE" \
    -lc "set -e
peaky-dev-bootstrap
cd /project && exec peaky \"\$@\"" \
    _)
fi

if [ ${#filtered[@]} -gt 0 ]; then
  exec "${run_cmd[@]}" "${filtered[@]}"
else
  exec "${run_cmd[@]}"
fi
